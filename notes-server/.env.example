# Copy to .env. Loaded by air (.air.toml) and by systemd (EnvironmentFile=).
# Plain KEY=value only: no `export`, no inline comments.

# Markdown notes directory (absolute path).
NOTES_ROOT=/path/to/notes
# At least 6 characters; the desktop app must use the same token.
NOTES_TOKEN=change-me
# 127.0.0.1 when behind a reverse proxy; 0.0.0.0 to allow LAN access.
NOTES_BIND=127.0.0.1:8789
# Append target (Files.md Chat.md format), supports {YYYY} {MM} {DD}.
NOTES_INBOX=Chat.md
# Where titled captures without a leading / go, e.g. notes; empty is the root.
NOTES_NEW_DIR=
# Directory for uploaded images, linked relative to each note.
NOTES_ATTACHMENTS=media
# true: tiles load images without the token (trusted LAN only).
NOTES_PUBLIC_IMAGES=false
# Timezone for inbox dates, times and pasted image names.
TZ=Asia/Shanghai
